# -----------------------------------------------------------------------------
# Proyecto Quartus II 13.0 SP1 - Hello World FPGA4U (Cyclone II EP2C20F484)
# Pines sacados de https://fpga4u.epfl.ch/wiki/FPGA4U_Description.html
# -----------------------------------------------------------------------------
set_global_assignment -name FAMILY "Cyclone II"
# Mira la serigrafía del chip: si pone EP2C20F484C6N, cambia C8 por C6.
set_global_assignment -name DEVICE EP2C20F484C8
set_global_assignment -name TOP_LEVEL_ENTITY hello_fpga4u
set_global_assignment -name VERILOG_FILE hello_fpga4u.v
set_global_assignment -name SDC_FILE hello_fpga4u.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# IMPORTANTE: los pines que no se usan quedan como entradas en alta impedancia.
# Por defecto Quartus los pone a GND, y en esta placa hay pines (interruptores
# SW1/SW2, Ethernet, SDRAM...) que podrían entrar en conflicto.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

# PIN_B3 (DEV_CLRn) se usa como I/O normal para el pulsador Rz (SW7).
set_global_assignment -name ENABLE_DEVICE_WIDE_RESET OFF

# EPCS16: modo de configuración Active Serial desde la flash.
set_global_assignment -name RESERVE_ASDO_AFTER_CONFIGURATION "AS INPUT TRI-STATED"
set_global_assignment -name CYCLONEII_CONFIGURATION_DEVICE EPCS16

# --- Reloj y reset ---
set_location_assignment PIN_L1 -to clk
set_location_assignment PIN_B3 -to rst_n

# --- Pulsadores SW3..SW6 (activos a nivel bajo) ---
set_location_assignment PIN_AB4 -to button_n[3]
set_location_assignment PIN_V12 -to button_n[2]
set_location_assignment PIN_U12 -to button_n[1]
set_location_assignment PIN_U11 -to button_n[0]

# --- LEDs de los pulsadores: amarillo, verde, naranja, rojo ---
set_location_assignment PIN_AB20 -to led_button[3]
set_location_assignment PIN_AA20 -to led_button[2]
set_location_assignment PIN_AA17 -to led_button[1]
set_location_assignment PIN_Y16  -to led_button[0]

# --- Matriz de 96 LEDs (activos a nivel alto) ---
set_location_assignment PIN_Y18 -to led[0]
set_location_assignment PIN_Y20 -to led[1]
set_location_assignment PIN_Y22 -to led[2]
set_location_assignment PIN_W22 -to led[3]
set_location_assignment PIN_V20 -to led[4]
set_location_assignment PIN_V22 -to led[5]
set_location_assignment PIN_U20 -to led[6]
